{
  "openapi": "3.1.0",
  "info": {
    "title": "incident-shop",
    "description": "API só de leitura com logs, métricas e deploys da loja fictícia, consumida pelo incident-agent. Horários em ISO 8601 com fuso -03:00; a mesma requisição devolve sempre o mesmo corpo.",
    "version": "1.1.0"
  },
  "paths": {
    "/saude": {
      "get": {
        "summary": "Verifica se a API está no ar",
        "description": "Devolve o estado da API, o nome da fonte de dados ativa e a versão do contrato.",
        "operationId": "saude_saude_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaSaude"
                }
              }
            }
          }
        }
      }
    },
    "/cenarios": {
      "get": {
        "summary": "Lista os cenários e suas janelas",
        "description": "Lista os 8 cenários de incidente com a janela de tempo de cada um. Não expõe a causa raiz.",
        "operationId": "cenarios_cenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaCenarios"
                }
              }
            }
          }
        }
      }
    },
    "/logs": {
      "get": {
        "summary": "Consulta logs por janela",
        "description": "Logs em ordem crescente de horário. Exige janela (`cenario` ou `inicio` e `fim`, até 6 horas).\n`total` conta todos os logs dos filtros; `truncado` indica que `total` passa de `limite`.",
        "operationId": "logs_logs_get",
        "parameters": [
          {
            "name": "cenario",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Id de um cenário de GET /cenarios.",
              "title": "Cenario"
            },
            "description": "Id de um cenário de GET /cenarios."
          },
          {
            "name": "servico",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pedidos-api",
                    "pagamentos-api",
                    "estoque-worker",
                    "auth-api"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtra por serviço.",
              "title": "Servico"
            },
            "description": "Filtra por serviço."
          },
          {
            "name": "inicio",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Começo da janela (inclusivo); sem fuso vale -03:00.",
              "title": "Inicio"
            },
            "description": "Começo da janela (inclusivo); sem fuso vale -03:00."
          },
          {
            "name": "fim",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fim da janela (exclusivo); sem fuso vale -03:00.",
              "title": "Fim"
            },
            "description": "Fim da janela (exclusivo); sem fuso vale -03:00."
          },
          {
            "name": "nivel",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "INFO",
                    "WARN",
                    "ERROR"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtro exato de nível.",
              "title": "Nivel"
            },
            "description": "Filtro exato de nível."
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "description": "Máximo de logs devolvidos.",
              "default": 500,
              "title": "Limite"
            },
            "description": "Máximo de logs devolvidos."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaLogs"
                }
              }
            }
          },
          "404": {
            "description": "O `cenario` informado não existe."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
